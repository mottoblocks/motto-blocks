{
	"__patterns": [
		{
			"match": "^--(?:.*-)?columns$",
			"type": "number",
			"min": 1,
			"max": 12,
			"step": 1
		},
		{
			"match": "^--(?:.*-)?(?:gap|size)$",
			"type": "spacing-single"
		},
		{
			"match": "^(?:--(?:.*-)?margin|(?!--)(?:.*-)?margin)$",
			"type": "spacing-multiple",
			"allowSplit": true,
			"hasAutoValue": true,
			"allowNegativeValue": true
		},
		{
			"match": "^(?:--(?:.*-)?padding|(?!--)(?:.*-)?padding)$",
			"allowSplit": true,
			"type": "spacing-multiple"
		},
		{
			"match": "^(?:--(?:.*-)?margin-(?:top|right|bottom|left)|(?!--)(?:.*-)?margin-(?:top|right|bottom|left))$",
			"type": "spacing-single",
			"hasAutoValue": true,
			"allowNegativeValue": true
		},
		{
			"match": "^(?:--(?:.*-)?padding-(?:top|right|bottom|left)|(?!--)(?:.*-)?padding-(?:top|right|bottom|left))$",
			"type": "spacing-single"
		},
		{
			"match": "^(?:--(?:.*-)?margin-block|(?!--)(?:.*-)?margin-block)$",
			"type": "spacing-multiple",
			"sides": ["start", "end"],
			"axis": "block",
			"hasAutoValue": true,
			"allowNegativeValue": true
		},
		{
			"match": "^(?:--(?:.*-)?margin-inline|(?!--)(?:.*-)?margin-inline)$",
			"type": "spacing-multiple",
			"sides": ["start", "end"],
			"axis": "inline",
			"hasAutoValue": true,
			"allowNegativeValue": true
		},
		{
			"match": "^(?:--(?:.*-)?padding-block|(?!--)(?:.*-)?padding-block)$",
			"type": "spacing-multiple",
			"sides": ["start", "end"],
			"axis": "block"
		},
		{
			"match": "^(?:--(?:.*-)?padding-inline|(?!--)(?:.*-)?padding-inline)$",
			"type": "spacing-multiple",
			"sides": ["start", "end"],
			"axis": "inline"
		},
		{
			"match": "^(?:--(?:.*-)?margin-(?:block|inline)-(?:start|end)|(?!--)(?:.*-)?margin-(?:block|inline)-(?:start|end))$",
			"type": "spacing-single",
			"hasAutoValue": true,
			"allowNegativeValue": true
		},
		{
			"match": "^(?:--(?:.*-)?padding-(?:block|inline)-(?:start|end)|(?!--)(?:.*-)?padding-(?:block|inline)-(?:start|end))$",
			"type": "spacing-single"
		},
		{
			"match": "^(?:--(?:.*-)?inset-(?:top|right|bottom|left)|(?!--)(?:.*-)?inset-(?:top|right|bottom|left))$",
			"type": "spacing-single",
			"hasAutoValue": true,
			"allowNegativeValue": true,
			"requires": [
				{
					"prop": "position"
				}
			]
		},
		{
			"match": "^(?:--(?:.*-)?inset|(?!--)(?:.*-)?inset)$",
			"type": "spacing-multiple",
			"allowSplit": true,
			"defaultMode": "custom",
			"allowNegativeValue": true,
			"requires": [
				{
					"prop": "position"
				}
			]
		},
		{
			"match": "^(?:--(?:.*-)?inset-block|(?!--)(?:.*-)?inset-block)$",
			"type": "spacing-multiple",
			"sides": ["start", "end"],
			"axis": "block",
			"allowNegativeValue": true,
			"requires": [
				{
					"prop": "position"
				}
			]
		},
		{
			"match": "^(?:--(?:.*-)?inset-inline|(?!--)(?:.*-)?inset-inline)$",
			"type": "spacing-multiple",
			"sides": ["start", "end"],
			"axis": "inline",
			"allowNegativeValue": true,
			"requires": [
				{
					"prop": "position"
				}
			]
		},
		{
			"match": "^(?:--(?:.*-)?(?:height|width)|(?!--)(?:.*-)?(?:height|width))$",
			"type": "spacing-single",
			"hasAutoValue": true,
			"defaultMode": "custom"
		},
		{
			"match": "^(?:--(?:.*-)?(?:min|max)-(?:height|width)|(?!--)(?:.*-)?(?:min|max)-(?:height|width))$",
			"type": "spacing-single"
		},
		{
			"match": "^(?:top|right|bottom|left)$",
			"type": "spacing-single",
			"hasAutoValue": true,
			"defaultMode": "custom",
			"allowNegativeValue": true,
			"requires": [
				{
					"prop": "position"
				}
			]
		},
		{
			"match": "^--(?:.*-)?(?:top|right|bottom|left)$",
			"type": "spacing-single",
			"hasAutoValue": true,
			"defaultMode": "custom",
			"allowNegativeValue": true
		},
		{
			"match": "^(?:--(?:.*-)?(?:row-gap|column-gap)|(?!--)(?:.*-)?(?:row-gap|column-gap))$",
			"type": "spacing-single",
			"requires": [
				{
					"prop": "display"
				}
			]
		},
		{
			"match": "^(?:--(?:.*-)?line-height|(?!--)(?:.*-)?line-height)$",
			"type": "length",
			"initialUnit": "",
			"units": [
				{ "value": "", "label": "N" },
				{ "value": "em", "label": "em" },
				{ "value": "rem", "label": "rem" },
				{ "value": "px", "label": "px" },
				{ "value": "%", "label": "%" }
			]
		},
		{
			"match": "^(?:--(?:.*-)?border-radius|(?!--)(?:.*-)?border-radius)$",
			"type": "border-radius"
		},
		{
			"match": "^(?:--(?:.*-)?font-weight|(?!--)(?:.*-)?font-weight)$",
			"type": "enum",
			"optionsRef": "font-weight"
		},
		{
			"match": "^(?:--(?:.*-)?font-style|(?!--)(?:.*-)?font-style)$",
			"type": "enum",
			"options": [
				{
					"name": "normal"
				},
				{
					"name": "italic"
				},
				{
					"name": "oblique"
				}
			]
		},
		{
			"match": "^(?:--(?:.*-)?(?:(?:[a-z]+-)*color|fill|stroke)|(?!--)(?:.*-)?(?:(?:[a-z]+-)*color|fill|stroke))$",
			"type": "color"
		},
		{
			"match": "^(?:--(?:.*-)?(?:[a-z]+-)*opacity|(?!--)(?:.*-)?(?:[a-z]+-)*opacity)$",
			"type": "percent"
		},
		{
			"match": "^border-(?:top|right|bottom|left)$",
			"type": "border"
		},
		{
			"match": "^(?!--)(?:.*-)?border-color$",
			"type": "color"
		},
		{
			"match": "^--(?:.*-)?(?:transition-)?duration$",
			"type": "transition-duration"
		},
		{
			"match": "^--(?:.*-)?(?:transition-)?delay$",
			"type": "transition-duration"
		},
		{
			"match": "^--(?:.*-)?(?:ease|easing|timing-function)$",
			"type": "transition-easing"
		},
		{
			"match": "^--(?:.*-)?transition-property$",
			"type": "transition-property"
		}
	],
