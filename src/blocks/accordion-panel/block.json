{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "motto/accordion-panel",
	"version": "0.1.0",
	"title": "Accordion Panel",
	"category": "design",
	"icon": "excerpt-view",
	"description": "Collapsible content panel for a single Motto Accordion item.",
	"parent": ["motto/accordion-item"],
	"usesContext": ["motto/accordion-item-itemId", "motto/accordion-item-isOpen"],
	"attributes": {
		"itemId": {
			"type": "string",
			"default": ""
		},
		"isOpen": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"inserter": false,
		"reusable": false
	},
	"mottoBaseLayout": "flow",
	"textdomain": "motto-blocks",
	"mottoAI": {
		"description": "Content panel inside motto/accordion-item. Accepts any inner blocks as panel content.",
		"examplePrompts": []
	}
}
