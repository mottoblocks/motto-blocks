{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "motto/tab-panels",
	"version": "0.1.0",
	"title": "Tab Panels",
	"category": "design",
	"icon": "screenoptions",
	"description": "Panels container for Motto Tabs.",
	"parent": ["motto/tabs"],
	"usesContext": ["motto/tabs-activeTabId"],
	"supports": {
		"html": false,
		"anchor": true,
		"reusable": false,
		"inserter": false
	},
	"mottoDefaults": {
		"blockSelectors": [
			{
				"selector": "&{BLOCK} :is(.motto-tab)",
				"label": "Tab panel",
				"css": {
					"desktop": [
						{ "name": "padding", "value": ".75em" },
						{ "name": "background-color" },
						{ "name": "border", "value": "solid 1px #eee" }
					]
				}
			}
		]
	},
	"mottoBaseLayout": "flow",
	"textdomain": "motto-blocks",
	"mottoAI": {
		"description": "Content panels container inside motto/tabs. Contains one motto/tab per tab. Always the second child of motto/tabs, paired with a motto/tab-container sibling.",
		"examplePrompts": []
	}
}
