{
  "name": "motto-blocks",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "assemble:free": "node scripts/assemble-plugin.mjs",
    "icons:registry": "node scripts/generate-lucide-registry.mjs",
    "icons:lucide-vendor": "node scripts/copy-lucide-icons.mjs",
    "validate:boundaries": "node scripts/validate-import-boundaries.mjs",
    "dev": "node scripts/watch-build.mjs",
    "build": "npm run build:free && npm run assemble:free",
    "build:ci": "npm run build:free",
    "build:free": "vite build",
    "build:free:watch": "vite build --watch",
    "predev": "npm run icons:registry && npm run icons:lucide-vendor && npm run sass:build",
    "prebuild": "npm run validate:boundaries && npm run icons:registry && npm run icons:lucide-vendor && npm run sass:build",
    "prebuild:ci": "npm run validate:boundaries && npm run icons:registry && npm run icons:lucide-vendor && npm run sass:build",
    "sass:build": "sass --load-path=src/components --no-source-map src/blocks/scss:assets/css/blocks src/styler:assets/css/styler",
    "sass:watch": "sass --watch --load-path=src/components --no-source-map src/blocks/scss:assets/css/blocks src/styler:assets/css/styler",
    "test:unit": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,scss}\"",
    "zip:prod": "npm run build && node scripts/zip-production.mjs",
    "validate:value-options": "node scripts/validate-value-options.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.543.0",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "lucide-static": "^1.49.0",
    "mdn-data": "^2.28.0",
    "prettier": "^3.3.0",
    "sass": "^1.99.0",
    "vite": "^5.4.14",
    "vitest": "^3.2.4"
  }
}
